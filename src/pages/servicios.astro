---
import Layout from '../layouts/Layout.astro';
import Services from '../components/Services.astro';
---
<Layout title="Servicios" description="Paquetes de cobertura fotográfica para bodas, retratos y eventos.">
  <section class="px-6 md:px-10 pt-32 pb-8 reveal">
    <h1 class="editorial-heading text-5xl md:text-7xl">Servicios & Paquetes</h1>
    <p class="mt-4 max-w-xl text-ivory/70">
      Cobertura editorial adaptada a cada historia. Todos los paquetes incluyen consulta previa y edición profesional.
    </p>
  </section>
  <Services />
</Layout>