---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ContactForm from '../components/ContactForm.astro';
import contactBg from '../assets/gallery/portada-contacto.jpg'; 
---
<Layout title="Contacto" description="Reserva tu sesión de fotografía.">
  <div class="relative w-full overflow-clip">
    <div class="absolute inset-0 w-full h-full z-0">
      <Image 
        src={contactBg} 
        alt="Fondo de Contacto" 
        class="w-full h-full object-cover object-[40%_30%] md:object-[center_30%] scale-135 md:scale-110"
        loading="eager"
      />
      <div class="absolute inset-0 bg-[#0D0D0D]/50"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0D0D0D]/70 to-[#0D0D0D]"></div>
    </div>

    <section class="relative w-full h-[100svh] flex items-center justify-center">
      <div class="relative z-10 flex flex-col items-center text-center px-6 reveal">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl tracking-[0.15em] uppercase mb-4 drop-shadow-lg">
          Reserva tu Sesión
        </h1>
        <p class="text-platinum text-xs md:text-sm tracking-[0.4em] uppercase drop-shadow-md">
          Hablemos por WhatsApp
        </p>
        
        <div class="flex items-center gap-6 mt-6 mb-2">
          <!-- Agrega aquí los enlaces SVG de redes sociales que ya tenías -->
        </div>

        <a 
          href="#formulario-contacto" 
          class="mt-8 px-8 py-3 border border-platinum text-white uppercase text-xs tracking-widest hover:bg-platinum hover:text-black transition-colors duration-300"
        >
          Llenar Formulario
        </a>
      </div>
    </section>

    <!-- SECCIÓN DEL FORMULARIO -->
    <section id="formulario-contacto" class="scroll-mt-24 relative z-10 px-6 md:px-10 min-h-[80svh] flex flex-col justify-center max-w-2xl mx-auto reveal pb-20">
      <div class="w-full bg-black/30 border border-white/10 rounded-2xl p-8 md:p-12 shadow-2xl">
        <ContactForm />
      </div>
    </section>
  </div>

  <script>
    function initScrollButton() {
      const btnScroll = document.querySelector('a[href="#formulario-contacto"]');
      if (btnScroll) {
        btnScroll.addEventListener('click', (e) => {
          e.preventDefault(); 
          const formSection = document.getElementById('formulario-contacto');
          if (formSection) {
            formSection.scrollIntoView({ behavior: 'smooth' }); 
          }
        });
      }
    }
    
    // De nuevo, obligamos a Astro a escuchar el evento de carga de vista
    document.addEventListener('astro:page-load', initScrollButton);
  </script>
</Layout>