---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import contactBg from '../assets/gallery/portadacontacto.jpg'; 
---
<Layout title="Contacto" description="Reserva tu sesión de fotografía.">

  <!-- WRAPPER GENERAL: aquí va el fondo compartido entre el Hero y el Formulario -->
  <div class="relative w-full overflow-hidden">

    <!-- FONDO ÚNICO que cubre TODO el wrapper (hero + formulario) -->
    <div class="absolute inset-0 w-full h-full z-0">
      <Image 
        src={contactBg} 
        alt="Fondo de Contacto" 
        class="w-full h-full object-cover object-[40%_30%] md:object-[center_30%] scale-135 md:scale-110"
        loading="eager"
      />
      <!-- Overlay oscuro base -->
      <div class="absolute inset-0 bg-[#0D0D0D]/50"></div>
      <!-- Degradado hacia abajo para que la imagen se funda con el fondo de la página al terminar el formulario -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-[#0D0D0D]/70 to-[#0D0D0D]"></div>
    </div>

    <!-- HERO DE CONTACTO (Texto limpio sobre la foto) -->
    <section class="relative w-full h-[100svh] flex items-center justify-center">
      <div class="relative z-10 flex flex-col items-center text-center px-6 reveal">
        <h1 class="text-white text-4xl md:text-5xl lg:text-6xl tracking-[0.15em] uppercase mb-4 drop-shadow-lg">
          Reserva tu Sesión
        </h1>
        <p class="text-platinum text-xs md:text-sm tracking-[0.4em] uppercase drop-shadow-md">
          Hablemos por WhatsApp
        </p>
      </div>
    </section>

    <!-- SECCIÓN DEL FORMULARIO (Envuelto en la tarjeta con Blur y esquinas redondeadas) -->
    <section class="relative z-10 px-6 md:px-10 pt-8 md:pt-24 pb-24 max-w-2xl mx-auto reveal">
      <div class="bg-black/30 backdrop-blur-xl border border-white/10 rounded-2xl p-8 md:p-12 shadow-2xl">
        <form id="contact-form" class="space-y-6">
          <div>
            <label class="block uppercase text-xs tracking-widest text-ivory/60 mb-2">Nombre</label>
            <input name="name" type="text" required class="w-full bg-transparent border-b border-platinum/40 py-3 focus:border-platinum outline-none text-white transition-colors" />
          </div>
          
          <div>
            <label class="block uppercase text-xs tracking-widest text-ivory/60 mb-2">Tipo de sesión</label>
            <select name="type" class="w-full bg-transparent border-b border-platinum/40 py-3 focus:border-platinum outline-none text-white cursor-pointer transition-colors bg-[#0D0D0D]">
              <option value="boda" class="text-black bg-white">Boda</option>
              <option value="retrato" class="text-black bg-white">Retrato</option>
              <option value="evento" class="text-black bg-white">Evento</option>
            </select>
          </div>
          
          <div>
            <label class="block uppercase text-xs tracking-widest text-ivory/60 mb-2">Mensaje</label>
            <textarea name="message" rows="4" required class="w-full bg-transparent border-b border-platinum/40 py-3 focus:border-platinum outline-none text-white transition-colors resize-none"></textarea>
          </div>
          
          <button type="submit" class="w-full border border-platinum py-4 mt-4 uppercase text-sm tracking-widest hover:bg-platinum hover:text-carbon transition-colors duration-300 flex justify-center items-center gap-3">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            Enviar por WhatsApp
          </button>
        </form>
      </div>
    </section>

  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    
    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault(); 
        
        const formData = new FormData(form);
        const name = formData.get('name');
        const type = formData.get('type');
        const message = formData.get('message');
        
        const waMessage = `¡Hola! Mi nombre es ${name}.\n\nMe interesa reservar una sesión para: *${type}*.\n\nMensaje: ${message}`;
        const phoneNumber = '524112301946';
        
        const whatsappUrl = `https://wa.me/${phoneNumber}?text=${encodeURIComponent(waMessage)}`;
        
        window.location.href = whatsappUrl;
      });
    }
  </script>
</Layout>