---
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

// 1. Obtenemos las fotos originales
const basePhotos = Object.entries(imageFiles).map(([path, mod]) => mod.default);

// 2. TRUCO PRO: Triplicamos las fotos para simular un bucle infinito (sin que el usuario lo note)
const carouselPhotos = [...basePhotos, ...basePhotos, ...basePhotos];
---
<section class="relative w-full py-24 bg-[#0D0D0D] group/section flex flex-col items-center overflow-hidden">
  
  <button id="prev-slide" class="absolute left-4 md:left-10 top-[45%] -translate-y-1/2 z-20 bg-carbon/50 border border-white/10 hover:bg-platinum hover:text-carbon hover:scale-110 text-white p-4 rounded-full backdrop-blur-md transition-all duration-500 opacity-0 group-hover/section:opacity-100 hidden md:flex items-center justify-center outline-none">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
  </button>

  <!-- Pasamos el dato de cuántas fotos originales hay en 'data-original-length' -->
  <div id="carousel-track" data-original-length={basePhotos.length} class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-6 px-[7.5vw] md:px-[30vw] lg:px-[36vw] w-full py-8">
    {carouselPhotos.map((photo, index) => (
      <div class="carousel-slide snap-center shrink-0 w-[85vw] md:w-[40vw] lg:w-[28vw] h-[60vh] md:h-[70vh] relative overflow-hidden cursor-grab active:cursor-grabbing transition-all duration-700 ease-out opacity-40 scale-90 [&.is-active]:opacity-100 [&.is-active]:scale-100 shadow-2xl rounded-sm">
        <Image 
          src={photo} 
          alt={`Fotografía destacada ${index + 1}`} 
          class="w-full h-full object-cover transition-transform duration-[1.5s] ease-out [&.is-active>img]:scale-105" 
          loading="lazy" 
          widths={[400, 800, 1200]} 
          sizes="(max-width: 768px) 85vw, (max-width: 1024px) 40vw, 28vw" 
        />
        <div class="absolute inset-0 bg-gradient-to-t from-carbon/80 via-transparent to-transparent opacity-0 transition-opacity duration-700 [.is-active_&]:opacity-100"></div>
      </div>
    ))}
  </div>

  <button id="next-slide" class="absolute right-4 md:right-10 top-[45%] -translate-y-1/2 z-20 bg-carbon/50 border border-white/10 hover:bg-platinum hover:text-carbon hover:scale-110 text-white p-4 rounded-full backdrop-blur-md transition-all duration-500 opacity-0 group-hover/section:opacity-100 hidden md:flex items-center justify-center outline-none">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
  </button>
  
  <div class="mt-8 z-10 reveal">
    <a href="/galeria" class="inline-block border border-platinum/50 text-platinum hover:bg-platinum hover:text-carbon uppercase tracking-[0.2em] text-xs md:text-sm py-4 px-10 transition-all duration-500 hover:shadow-[0_0_20px_rgba(192,192,192,0.3)]">
      Explorar Portafolio
    </a>
  </div>
</section>

<script>
  function initCarousel() {
    const track = document.getElementById('carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');

    if (!track || slides.length === 0) return;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-active');
        } else {
          entry.target.classList.remove('is-active');
        }
      });
    }, {
      root: track,
      rootMargin: '0px -40% 0px -40%', 
      threshold: 0.1 
    });

    slides.forEach(slide => observer.observe(slide));

    const getScrollAmount = () => {
      const slideWidth = (slides[0] as HTMLElement).offsetWidth;
      return slideWidth + 24; 
    };

    // --- SOLUCIÓN AL ESPACIO VACÍO ---
    const originalLength = parseInt(track.dataset.originalLength || '0');
    
    // Adelantamos el scroll de forma instantánea hasta el bloque del medio
    setTimeout(() => {
      // Al multiplicar el ancho de la tarjeta por la cantidad original, 
      // nos saltamos el primer bloque clonado.
      track.scrollLeft = getScrollAmount() * originalLength;
    }, 10);

    const scrollNext = () => {
      if (track.scrollLeft >= (track.scrollWidth - track.clientWidth - 10)) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      }
    };

    const scrollPrev = () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    };

    if (nextBtn) nextBtn.addEventListener('click', scrollNext);
    if (prevBtn) prevBtn.addEventListener('click', scrollPrev);

    let autoPlayInterval = setInterval(scrollNext, 4000); 

    const pauseAutoPlay = () => clearInterval(autoPlayInterval);
    const startAutoPlay = () => {
      clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(scrollNext, 4000);
    };

    track.addEventListener('mouseenter', pauseAutoPlay);
    track.addEventListener('mouseleave', startAutoPlay);
    track.addEventListener('touchstart', pauseAutoPlay, { passive: true });
    track.addEventListener('touchend', startAutoPlay, { passive: true });
  }

  document.addEventListener('astro:page-load', initCarousel);
</script>