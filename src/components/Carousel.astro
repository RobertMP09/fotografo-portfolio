---
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

const carouselPhotos = Object.entries(imageFiles).map(([path, mod]) => mod.default);
---
<section class="relative w-full py-16 bg-[#0D0D0D] group/section flex flex-col items-center overflow-hidden">
  <button id="prev-slide" class="absolute left-6 top-[45%] -translate-y-1/2 z-20 bg-[#0D0D0D]/70 hover:bg-platinum hover:text-carbon text-white p-4 rounded-full backdrop-blur-md transition-all duration-300 opacity-0 group-hover/section:opacity-100 hidden md:block outline-none">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 19l-7-7 7-7"></path></svg>
  </button>

  <div id="carousel-track" class="flex overflow-x-auto snap-x snap-mandatory hide-scrollbar gap-4 px-[7.5vw] md:px-[10vw] lg:px-[5vw] w-full">
    {carouselPhotos.map((photo, index) => (
      <div class="snap-center shrink-0 w-[85vw] md:w-[40vw] lg:w-[28vw] h-[60vh] md:h-[70vh] relative group cursor-grab active:cursor-grabbing">
        <Image 
          src={photo} 
          alt={`Fotografía destacada ${index + 1}`} 
          class="w-full h-full object-cover brightness-[0.8] contrast-[1.1] group-hover:brightness-100 transition-all duration-700" 
          loading="lazy" 
          widths={[400, 800, 1200]} 
          sizes="(max-width: 768px) 85vw, (max-width: 1024px) 40vw, 28vw" 
        />
      </div>
    ))}
  </div>

  <button id="next-slide" class="absolute right-6 top-[45%] -translate-y-1/2 z-20 bg-[#0D0D0D]/70 hover:bg-platinum hover:text-carbon text-white p-4 rounded-full backdrop-blur-md transition-all duration-300 opacity-0 group-hover/section:opacity-100 hidden md:block outline-none">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 5l7 7-7 7"></path></svg>
  </button>
  
  <div class="mt-12 z-10">
    <a href="/galeria" class="inline-block border border-platinum/50 text-platinum hover:bg-platinum hover:text-carbon uppercase tracking-[0.2em] text-sm py-4 px-10 transition-colors duration-300">
      Mirar Trabajos
    </a>
  </div>
</section>

<script>
  function initCarousel() {
    const track = document.getElementById('carousel-track');
    const prevBtn = document.getElementById('prev-slide');
    const nextBtn = document.getElementById('next-slide');

    if (!track) return;

    const getScrollAmount = () => {
      if (window.innerWidth < 768) return window.innerWidth * 0.85; 
      if (window.innerWidth < 1024) return window.innerWidth * 0.40; 
      return window.innerWidth * 0.28; 
    };

    const scrollNext = () => {
      if (track.scrollLeft >= (track.scrollWidth - track.clientWidth - 10)) {
        track.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        track.scrollBy({ left: getScrollAmount(), behavior: 'smooth' });
      }
    };

    const scrollPrev = () => {
      track.scrollBy({ left: -getScrollAmount(), behavior: 'smooth' });
    };

    if (nextBtn) nextBtn.addEventListener('click', scrollNext);
    if (prevBtn) prevBtn.addEventListener('click', scrollPrev);

    let autoPlayInterval = setInterval(scrollNext, 3500);

    const pauseAutoPlay = () => clearInterval(autoPlayInterval);
    const startAutoPlay = () => {
      clearInterval(autoPlayInterval);
      autoPlayInterval = setInterval(scrollNext, 3500);
    };

    track.addEventListener('mouseenter', pauseAutoPlay);
    track.addEventListener('mouseleave', startAutoPlay);
    track.addEventListener('touchstart', pauseAutoPlay, { passive: true });
    track.addEventListener('touchend', startAutoPlay, { passive: true });
  }

  document.addEventListener('astro:page-load', initCarousel);
</script>