---
const packages = [
  {
    name: 'Editorial Boda',
    price: 'Desde $2,400',
    features: ['8 horas de cobertura', '2 fotógrafos', 'Álbum impreso 30x30', 'Entrega en 6 semanas'],
  },
  {
    name: 'Sesión de Retrato',
    price: 'Desde $450',
    features: ['2 horas de sesión', '1 locación', '25 fotos editadas', 'Entrega en 2 semanas'],
  },
  {
    name: 'Cobertura de Evento',
    price: 'Desde $900',
    features: ['4 horas de cobertura', 'Cobertura documental', '100+ fotos editadas', 'Entrega en 3 semanas'],
  },
];
---
<section class="px-6 md:px-10 py-24 grid md:grid-cols-3 gap-8">
  {packages.map((pkg) => (
    <article class="reveal border border-platinum/20 p-8 flex flex-col justify-between hover:border-platinum transition-colors duration-300">
      <div>
        <h3 class="editorial-heading text-3xl mb-2 text-ivory">{pkg.name}</h3>
        <p class="text-platinum text-sm uppercase tracking-widest mb-6">{pkg.price}</p>
        <ul class="space-y-3 text-ivory/70 text-sm">
          {pkg.features.map((f) => <li>— {f}</li>)}
        </ul>
      </div>
      <a href="/contacto" class="mt-10 inline-block text-center border border-platinum py-3 uppercase text-sm tracking-widest hover:bg-platinum hover:text-carbon transition-colors duration-300">
        Reservar Ahora
      </a>
    </article>
  ))}
</section>