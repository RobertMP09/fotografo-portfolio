      </svg>
    </a>
  </div>
</nav>

<script>
  function initNavbar() {
    const header = document.getElementById('main-header');
    
    // --- NUEVO: Lógica para el fondo al hacer scroll ---
    const handleScroll = () => {
      // Si el usuario bajó más de 50 pixeles...
      if (window.scrollY > 50) {
        // Quitamos la transparencia
        header?.classList.remove('bg-transparent', 'border-transparent');
        // Agregamos el fondo oscuro, desenfoque y borde
        header?.classList.add('bg-[#0D0D0D]/90', 'backdrop-blur-md', 'border-b', 'border-white/10');
      } else {
        // Si está hasta arriba, lo devolvemos a transparente
        header?.classList.add('bg-transparent', 'border-transparent');
        header?.classList.remove('bg-[#0D0D0D]/90', 'backdrop-blur-md', 'border-b', 'border-white/10');
      }
    };

    // Escuchamos cada que el usuario hace scroll
    window.addEventListener('scroll', handleScroll);
    
    // Ejecutamos la función una vez al cargar por si el usuario recarga a mitad de página
    handleScroll();

    // --- Lógica del menú móvil (se mantiene igual) ---
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (!toggleBtn || !mobileMenu) return;

    const toggleMenu = () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; 
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        document.body.style.overflow = ''; 
      }
    };

    toggleBtn.removeEventListener('click', toggleMenu);
    toggleBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>

<!-- Usamos is:global para que el scroll de la derecha cambie en toda la página -->
<style is:global>
  /* --- SCROLL VERTICAL PRINCIPAL DE LA PÁGINA (A la derecha) --- */
  ::-webkit-scrollbar {
    width: 6px; /* Lo hace mucho más delgado */
  }
  ::-webkit-scrollbar-track {
    background: #0D0D0D; /* Fondo oscuro que se funde con tu diseño */
  }
  ::-webkit-scrollbar-thumb {
    background: #333; /* Un gris sutil para la barra */
    border-radius: 10px;
  }
  ::-webkit-scrollbar-thumb:hover {
    background: #666; /* Brilla un poco al pasar el mouse */
  }

  /* --- Ocultamos el scroll horizontal feo del carrusel --- */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>