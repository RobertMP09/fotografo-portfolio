---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/galeria', label: 'Galería' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/contacto', label: 'Contacto' },
];
---
<!-- HEADER (Menú principal de arriba) -->
<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-[#0D0D0D]/90 border-b border-platinum/10">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 md:px-10 py-5">
    <a href="/" class="editorial-heading text-2xl tracking-editorial uppercase text-ivory">
      Roberto Melchi <span class="text-platinum">/ Fotógrafo</span>
    </a>

    <!-- Menú Escritorio -->
    <nav class="hidden md:flex items-center gap-10 text-sm uppercase tracking-widest text-ivory/80">
      {links.map((link) => (
        <a href={link.href} class="hover:text-platinum transition-colors duration-300">
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Botón Hamburguesa Móvil -->
    <button id="mobile-menu-toggle" class="md:hidden text-ivory p-2 focus:outline-none" aria-label="Abrir menú">
      <svg id="icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16"></path>
      </svg>
      <svg id="icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
</header>

<!-- MENÚ MÓVIL (Ahora está AFUERA del header para evitar el bug del navegador) -->
<nav id="mobile-menu" class="hidden md:hidden fixed top-0 left-0 w-full h-[100dvh] bg-[#0D0D0D] pt-32 px-6 flex-col items-center gap-10 z-40">
  {links.map((link) => (
    <a href={link.href} class="mobile-link text-2xl uppercase tracking-widest text-ivory/90 hover:text-white transition-colors duration-300">
      {link.label}
    </a>
  ))}
</nav>

<script>
  function initNavbar() {
    const toggleBtn = document.getElementById('mobile-menu-toggle');
    const mobileMenu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('icon-open');
    const iconClose = document.getElementById('icon-close');
    const mobileLinks = document.querySelectorAll('.mobile-link');

    if (!toggleBtn || !mobileMenu) return;

    const toggleMenu = () => {
      const isHidden = mobileMenu.classList.contains('hidden');
      
      if (isHidden) {
        mobileMenu.classList.remove('hidden');
        mobileMenu.classList.add('flex');
        iconOpen?.classList.add('hidden');
        iconClose?.classList.remove('hidden');
        document.body.style.overflow = 'hidden'; 
      } else {
        mobileMenu.classList.add('hidden');
        mobileMenu.classList.remove('flex');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        document.body.style.overflow = ''; 
      }
    };

    // Quitamos los event listeners anteriores si los hubiera (útil en Astro View Transitions)
    toggleBtn.removeEventListener('click', toggleMenu);
    toggleBtn.addEventListener('click', toggleMenu);

    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (!mobileMenu.classList.contains('hidden')) {
          toggleMenu();
        }
      });
    });
  }

  document.addEventListener('astro:page-load', initNavbar);
</script>