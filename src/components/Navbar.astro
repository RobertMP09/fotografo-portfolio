---
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/galeria', label: 'Galería' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/contacto', label: 'Contacto' },
];
---
<header class="fixed top-0 left-0 w-full z-50 backdrop-blur-md bg-carbon/70 border-b border-platinum/10">
  <div class="max-w-7xl mx-auto flex items-center justify-between px-6 md:px-10 py-5">
    <a href="/" class="editorial-heading text-2xl tracking-editorial uppercase text-ivory">
      Roberto Melchi <span class="text-platinum">/ Photo</span>
    </a>

    <nav class="hidden md:flex items-center gap-10 text-sm uppercase tracking-widest text-ivory/80">
      {links.map((link) => (
        <a href={link.href} class="hover:text-platinum transition-colors duration-300">
          {link.label}
        </a>
      ))}
    </nav>

    <button id="mobile-menu-toggle" class="md:hidden text-ivory" aria-label="Abrir menú">☰</button>
  </div>
</header>