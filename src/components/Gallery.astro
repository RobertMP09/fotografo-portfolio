---
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

function getCategory(filename: string): 'bodas' | 'retratos' | 'eventos' | 'otros' {
  if (filename.includes('wedding')) return 'bodas';
  if (filename.includes('portrait')) return 'retratos';
  if (filename.includes('event')) return 'eventos';
  return 'otros';
}

const photos = Object.entries(imageFiles).map(([path, mod]) => {
  const filename = path.split('/').pop() ?? '';
  return {
    src: mod.default,
    alt: filename.replace(/\.\w+$/, '').replace(/-/g, ' '),
    category: getCategory(filename),
  };
});

const categories = ['todos', 'bodas', 'retratos', 'eventos'];
---
<section class="px-6 md:px-10 pt-32 pb-24">
  <div class="flex flex-wrap gap-6 mb-12 reveal">
    {categories.map((cat) => (
      <button
        class="filter-btn uppercase text-sm tracking-widest text-ivory/60 hover:text-platinum data-[active=true]:text-platinum data-[active=true]:border-b border-platinum pb-1 transition-colors outline-none"
        data-filter={cat}
        data-active={cat === 'todos' ? 'true' : 'false'}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- Cambiamos a CSS Grid (grid-cols-X) que llena de izquierda a derecha -->
  <div id="photo-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {photos.map((photo) => (
      <button
        class="gallery-item group block w-full h-full reveal overflow-hidden cursor-zoom-in"
        data-category={photo.category}
        data-alt={photo.alt}
      >
        <!-- Agregamos 'h-full' para asegurar que la imagen llene la celda por completo -->
        <Image 
          src={photo.src} 
          alt={photo.alt} 
          class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105" 
          loading="lazy" 
          widths={[300, 600, 900]} 
          sizes="(max-width: 768px) 100vw, 33vw" 
        />
      </button>
    ))}
  </div>

  <!-- Se agregó backdrop-blur-sm para un efecto cristal elegante de fondo -->
  <div id="lightbox" class="fixed inset-0 bg-carbon/95 backdrop-blur-sm hidden items-center justify-center z-[100] p-6 transition-opacity" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-6 right-6 text-ivory text-4xl hover:text-white transition-colors outline-none" aria-label="Cerrar">&times;</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain shadow-2xl" />
  </div>
</section>

<script>
  function initGallery() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLButtonElement>('.gallery-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');

    // Lógica de filtrado
    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        
        // Actualizar estado visual de los botones
        buttons.forEach((b) => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';
        
        // Mostrar/Ocultar imágenes
        items.forEach((item) => {
          const show = filter === 'todos' || item.dataset.category === filter;
          (item as HTMLElement).style.display = show ? 'block' : 'none';
        });
      });
    });

    // Lógica para abrir el Lightbox
    items.forEach((item) => {
      item.addEventListener('click', () => {
        if (!lightbox || !lightboxImg) return;
        const imgEl = item.querySelector('img');
        lightboxImg.src = imgEl?.currentSrc || imgEl?.src || '';
        lightboxImg.alt = item.dataset.alt || '';
        
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        
        // Evita que la página del fondo haga scroll cuando el lightbox está abierto
        document.body.style.overflow = 'hidden'; 
      });
    });

    // Función unificada para cerrar el Lightbox
    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = ''; // Devuelve el scroll a la normalidad
    };

    // 1. Cerrar al dar clic en la X
    closeBtn?.addEventListener('click', closeLightbox);

    // 2. Cerrar al dar clic en el fondo oscuro
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) {
        closeLightbox();
      }
    });

    // 3. Cerrar al presionar la tecla Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) {
        closeLightbox();
      }
    });
  }

  // Asegurar que funcione correctamente con las transiciones de Astro
  document.addEventListener('astro:page-load', initGallery);
</script>