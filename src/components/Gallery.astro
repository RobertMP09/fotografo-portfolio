---
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

function getCategory(filename: string): 'bodas' | 'retratos' | 'eventos' | 'otros' {
  if (filename.includes('wedding')) return 'bodas';
  if (filename.includes('portrait')) return 'retratos';
  if (filename.includes('event')) return 'eventos';
  return 'otros';
}

const photos = Object.entries(imageFiles).map(([path, mod]) => {
  const filename = path.split('/').pop() ?? '';
  return {
    src: mod.default,
    alt: filename.replace(/\.\w+$/, '').replace(/-/g, ' '),
    category: getCategory(filename),
  };
});

const categories = ['todos', 'bodas', 'retratos', 'eventos'];
---
<section class="px-6 md:px-10 pt-4 pb-24">
  
  <!-- CONTENEDOR DE BOTONES con la línea divisoria arriba (pt-8 border-t) -->
  <div class="flex flex-wrap items-center justify-center gap-4 mb-10 pt-8 border-t border-white/10 reveal">
    {categories.map((cat) => (
      <button
        class="filter-btn uppercase text-xs tracking-widest px-6 py-2.5 rounded-full border transition-all duration-300 outline-none
               text-ivory/60 border-white/10 hover:border-platinum hover:text-platinum 
               data-[active=true]:bg-platinum data-[active=true]:text-carbon data-[active=true]:border-platinum"
        data-filter={cat}
        data-active={cat === 'todos' ? 'true' : 'false'}
      >
        {cat}
      </button>
    ))}
  </div>

  <!-- CONTENEDOR GRID -->
  <div id="photo-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
    {photos.map((photo) => (
      <button
        class="gallery-item group relative block w-full aspect-[4/5] reveal overflow-hidden cursor-zoom-in rounded-sm"
        data-category={photo.category}
        data-alt={photo.alt}
      >
        <Image 
          src={photo.src} 
          alt={photo.alt} 
          class="w-full h-full object-cover transform transition-all duration-700 group-hover:scale-110 group-hover:blur-[2px]" 
          loading="lazy" 
          widths={[300, 600, 900]} 
          sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw" 
        />
        
        <div class="absolute inset-0 bg-carbon/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center pointer-events-none z-10">
          <span class="text-white text-xs tracking-[0.4em] uppercase translate-y-4 group-hover:translate-y-0 transition-transform duration-500 drop-shadow-lg">
            {photo.category}
          </span>
          <div class="w-8 h-[1px] bg-white mt-3 scale-x-0 group-hover:scale-x-100 transition-transform duration-700 delay-100"></div>
        </div>
      </button>
    ))}
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-carbon/95 backdrop-blur-sm hidden items-center justify-center z-[100] p-6 transition-opacity" role="dialog" aria-modal="true">
    <button id="lightbox-close" class="absolute top-6 right-6 text-ivory text-4xl hover:text-white transition-colors outline-none" aria-label="Cerrar">&times;</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain shadow-2xl" />
  </div>
</section>

<script>
  function initGallery() {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
    const items = document.querySelectorAll<HTMLButtonElement>('.gallery-item');
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        
        buttons.forEach((b) => (b.dataset.active = 'false'));
        btn.dataset.active = 'true';
        
        const updateDOM = () => {
          items.forEach((item) => {
            const show = filter === 'todos' || item.dataset.category === filter;
            (item as HTMLElement).style.display = show ? 'block' : 'none';
          });
        };

        if (document.startViewTransition) {
          document.startViewTransition(updateDOM);
        } else {
          updateDOM();
        }
      });
    });

    items.forEach((item) => {
      item.addEventListener('click', () => {
        if (!lightbox || !lightboxImg) return;
        const imgEl = item.querySelector('img');
        lightboxImg.src = imgEl?.currentSrc || imgEl?.src || '';
        lightboxImg.alt = item.dataset.alt || '';
        
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden'; 
      });
    });

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = ''; 
    };

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) closeLightbox();
    });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>

<style is:global>
  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.5s;
  }
</style>