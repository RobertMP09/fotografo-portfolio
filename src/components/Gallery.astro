---
import { Image } from 'astro:assets';

const imageFiles = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/gallery/*.{jpeg,jpg,png,webp}',
  { eager: true }
);

function getCategory(filename: string): 'bodas' | 'retratos' | 'eventos' {
  if (filename.includes('wedding') || filename.includes('boda')) return 'bodas';
  if (filename.includes('portrait') || filename.includes('retrato')) return 'retratos';
  return 'eventos';
}

const photos = Object.entries(imageFiles).map(([path, mod]) => {
  const filename = path.split('/').pop() ?? '';
  return {
    src: mod.default,
    alt: filename.replace(/\.\w+$/, '').replace(/-/g, ' '),
    category: getCategory(filename),
  };
});

const categoryConfigs = [
  { id: 'eventos', label: 'EVENTOS', subtitle: 'Momentos Únicos' },
  { id: 'bodas', label: 'BODAS', subtitle: 'Historias de Amor' },
  { id: 'retratos', label: 'RETRATOS', subtitle: 'Esencia & Editorial' },
];

const categoriesWithCover = categoryConfigs.map((cat) => {
  const coverPhoto = photos.find((p) => p.category === cat.id) || photos[0];
  return {
    ...cat,
    cover: coverPhoto,
  };
});
---

<section class="w-full min-h-screen bg-black px-4 sm:px-6 pt-24 pb-12">
  
  <!-- VISTA 1: PORTADAS EN COLUMNAS (Adaptado a móviles) -->
  <div id="hero-columns" class="grid grid-cols-1 md:grid-cols-3 gap-4 min-h-[75vh] w-full max-w-[1600px] mx-auto">
    {categoriesWithCover.map((cat) => (
      <button
        class="category-column group relative w-full h-[380px] md:h-full overflow-hidden rounded-md cursor-pointer border border-white/10"
        data-category={cat.id}
        data-label={cat.label}
      >
        <!-- Imagen ajustada con object-top para evitar recortar rostros en móvil -->
        <Image 
          src={cat.cover.src} 
          alt={cat.label} 
          class="absolute inset-0 w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105" 
          loading="eager"
        />
        
        <!-- Degradado -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-black/10 group-hover:via-black/10 transition-colors duration-500"></div>

        <!-- Contenido Tipográfico -->
        <div class="relative z-10 h-full flex flex-col justify-end p-6 md:p-8 text-left">
          <span class="text-xs uppercase tracking-[0.3em] text-white/70 mb-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300">
            {cat.subtitle}
          </span>
          <h2 class="text-white text-3xl sm:text-4xl lg:text-5xl font-extralight tracking-[0.2em] uppercase transition-all duration-300 group-hover:tracking-[0.25em]">
            {cat.label}
          </h2>
          <div class="w-12 h-[1px] bg-white/50 mt-4 group-hover:w-24 group-hover:bg-white transition-all duration-500"></div>
        </div>
      </button>
    ))}
  </div>

  <!-- VISTA 2: GALERÍA DE SECCIÓN SELECCIONADA -->
  <div id="section-view" class="hidden flex-col gap-8 max-w-[1600px] mx-auto">
    
    <!-- Encabezado con Botón Volver -->
    <div class="flex items-center justify-between border-b border-white/10 pb-4">
      <button 
        id="back-to-columns"
        class="text-xs uppercase tracking-[0.3em] text-white/70 hover:text-white transition-colors cursor-pointer flex items-center gap-2 group"
      >
        <span class="group-hover:-translate-x-1 transition-transform duration-300">&larr;</span> Volver al Portafolio
      </button>

      <h3 id="category-title" class="text-white text-lg md:text-2xl tracking-[0.3em] uppercase font-light"></h3>
    </div>

    <!-- Rejilla de Fotos -->
    <div id="photo-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
      {photos.map((photo) => (
        <button
          class="gallery-item group relative block w-full aspect-[4/5] overflow-hidden cursor-zoom-in rounded-sm border border-white/5"
          data-category={photo.category}
          data-alt={photo.alt}
        >
          <Image 
            src={photo.src} 
            alt={photo.alt} 
            class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" 
            loading="lazy" 
          />
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
        </button>
      ))}
    </div>
  </div>

  <!-- Lightbox -->
  <div id="lightbox" class="fixed inset-0 bg-black/95 backdrop-blur-md hidden items-center justify-center z-[100] p-6" role="dialog">
    <button id="lightbox-close" class="absolute top-6 right-6 text-white text-4xl outline-none hover:opacity-75 transition-opacity" aria-label="Cerrar">&times;</button>
    <img id="lightbox-img" src="" alt="" class="max-h-[90vh] max-w-[90vw] object-contain shadow-2xl" />
  </div>
</section>

<script>
  function initGallery() {
    const heroColumns = document.getElementById('hero-columns');
    const sectionView = document.getElementById('section-view');
    const categoryTitle = document.getElementById('category-title');
    const backBtn = document.getElementById('back-to-columns');
    const categoryCols = document.querySelectorAll<HTMLButtonElement>('.category-column');
    const items = document.querySelectorAll<HTMLButtonElement>('.gallery-item');
    
    const lightbox = document.getElementById('lightbox');
    const lightboxImg = document.getElementById('lightbox-img') as HTMLImageElement | null;
    const closeBtn = document.getElementById('lightbox-close');

    categoryCols.forEach((col) => {
      col.addEventListener('click', () => {
        const cat = col.dataset.category;
        const label = col.dataset.label || cat;
        if (!cat) return;

        heroColumns?.classList.add('hidden');
        sectionView?.classList.remove('hidden');
        sectionView?.classList.add('flex');

        if (categoryTitle) categoryTitle.textContent = label || '';

        items.forEach((item) => {
          const isMatch = item.dataset.category === cat;
          (item as HTMLElement).style.display = isMatch ? 'block' : 'none';
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    });

    backBtn?.addEventListener('click', () => {
      heroColumns?.classList.remove('hidden');
      sectionView?.classList.add('hidden');
      sectionView?.classList.remove('flex');
    });

    items.forEach((item) => {
      item.addEventListener('click', () => {
        if (!lightbox || !lightboxImg) return;
        const imgEl = item.querySelector('img');
        lightboxImg.src = imgEl?.currentSrc || imgEl?.src || '';
        lightboxImg.alt = item.dataset.alt || '';
        
        lightbox.classList.remove('hidden');
        lightbox.classList.add('flex');
        document.body.style.overflow = 'hidden'; 
      });
    });

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.classList.add('hidden');
      lightbox.classList.remove('flex');
      document.body.style.overflow = ''; 
    };

    closeBtn?.addEventListener('click', closeLightbox);
    lightbox?.addEventListener('click', (e) => {
      if (e.target === lightbox) closeLightbox();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !lightbox?.classList.contains('hidden')) closeLightbox();
    });
  }

  document.addEventListener('astro:page-load', initGallery);
</script>