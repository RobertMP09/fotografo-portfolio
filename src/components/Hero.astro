---
import { Image } from 'astro:assets';
import heroImage from '../assets/hero-main.jpg';
---
<section class="relative min-h-screen pt-32 pb-16 px-6 md:px-10 grid grid-cols-1 md:grid-cols-12 gap-6 overflow-hidden">
  <div class="md:col-span-7 flex flex-col justify-center reveal">
    <p class="uppercase tracking-editorial text-platinum text-sm mb-4">Fotografía · Bodas · Retrato · Eventos</p>
    <h1 class="editorial-heading text-6xl md:text-8xl leading-[0.95] text-ivory">
      Instantes que <em class="italic text-platinum">permanecen</em>
    </h1>
    <p class="mt-6 max-w-md text-ivory/70 text-lg">
      Un archivo visual construido con luz, silencio y composición. Cada sesión es una narrativa editorial hecha a medida.
    </p>
    <a href="/galeria" class="mt-8 inline-block w-fit border-b border-platinum pb-1 text-sm uppercase tracking-widest hover:text-platinum transition-colors">
      Ver Galería →
    </a>
  </div>

  <div class="md:col-span-5 relative reveal">
    <div class="hero-parallax relative aspect-[3/4] w-full overflow-hidden">
      <Image
        src={heroImage}
        alt="Retrato editorial en blanco y negro"
        class="hero-img absolute inset-0 w-full h-full object-cover"
        loading="eager"
        widths={[400, 800, 1200]}
        sizes="(max-width: 768px) 100vw, 40vw"
      />
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';

  function initParallax() {
    const img = document.querySelector('.hero-img');
    if (!img) return;
    gsap.fromTo(
      img,
      { y: -40 },
      {
        y: 40,
        ease: 'none',
        scrollTrigger: {
          trigger: img,
          start: 'top bottom',
          end: 'bottom top',
          scrub: true,
        },
      }
    );
  }
  document.addEventListener('astro:page-load', initParallax);
</script>