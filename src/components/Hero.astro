---
import { Image } from 'astro:assets';
// Asegúrate de que la ruta coincida con tu imagen
import heroImage from '../assets/hero-main.jpg'; 
---

<!-- Cambiamos h-[100dvh] por h-[100svh] para anclar el fondo -->
<section class="relative w-full h-[100svh] flex items-center justify-center overflow-hidden">
  
  <!-- Contenedor de la Imagen de Fondo -->
  <div class="absolute inset-0 w-full h-full z-0">
    <Image 
      src={heroImage} 
      alt="Roberto Melchi Fotografía" 
      class="w-full h-full object-cover object-[center_25%]" 
      loading="eager"
    />
    <div class="absolute inset-0 bg-black/40"></div>
  </div>

  <!-- Contenido Central (Se eliminó la clase 'reveal' para evitar movimientos) -->
  <div class="relative z-10 flex flex-col items-center text-center px-6 mt-16">
    <h1 class="text-ivory text-4xl md:text-6xl lg:text-7xl tracking-[0.15em] uppercase mb-4 drop-shadow-lg">
      Roberto Melchi
    </h1>
    <p class="text-platinum text-xs md:text-sm tracking-[0.4em] uppercase drop-shadow-md">
      Fotógrafo de Retratos
    </p>
  </div>
</section>